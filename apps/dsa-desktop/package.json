{
  "name": "daily-stock-analysis-desktop",
  "version": "3.21.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.daily-stock-analysis.desktop",
    "productName": "Daily Stock Analysis",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPackMacos.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../../dist/backend/stock_analysis",
        "to": "backend/stock_analysis"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "daily-stock-analysis-windows-installer-v${version}.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "ZhuLinsen",
          "repo": "daily_stock_analysis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "include": "installer.nsh"
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "target": "dmg"
    }
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "tmp": "0.2.7",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    }
  }
}
